---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Lens — SEO & GEO Analyzer' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Dual SEO and Generative Engine Optimization analysis — see your page the way both Googlebot and an AI crawler see it." />
  </head>
  <body>
    <slot />
  </body>
</html>
